{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true
  },
  "include": ["src", "functions", "test", "vite.config.ts", "vitest.config.ts"],
  // `test/e2e-prod` is a nested, non-workspace package: its `playwright`
  // dependency is installed by `npm install` inside that directory, never by
  // the root `npm ci`, so type-checking it from here can only fail in CI.
  // It carries its own tsconfig — see test/e2e-prod/tsconfig.json.
  "exclude": ["node_modules", "test/e2e-prod"]
}

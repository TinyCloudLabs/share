// Same account and zone as `packages/registry`. See DEPLOYMENT.md — nothing
// here deploys on merge.
{
  "name": "tinycloud-share-email",
  "account_id": "9959301f03d2db1a5fcf5e004278d467",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-22",
  "vars": {
    "SHARE_ORIGIN": "https://share.tinycloud.xyz",
    // The origin the Node actually serves on, NOT the `node.tinycloud.xyz`
    // alias. Three checks in `protocol.ts` are string-exact against this
    // value, and all three fail on the alias:
    //   - `authorization.targetOrigin === trust.nodeOrigin` — the Node stamps
    //     `targetOrigin` from its own resolved `target_origin`, which
    //     `config.rs` sets to the trust bundle's `nodeOrigin`
    //     (`https://tee.node.tinycloud.xyz`).
    //   - `authorization.nodeAudience === did:web:${hostname}` — the bundle
    //     pins `did:web:tee.node.tinycloud.xyz`.
    //   - `nodeInvitationKid.startsWith("did:web:${hostname}#")` — the
    //     enrolled kid is `did:web:tee.node.tinycloud.xyz#invitation-key-1`.
    // Set to the alias, every send is refused `untrusted` (TC-380).
    "NODE_ORIGIN": "https://tee.node.tinycloud.xyz",
    "EMAIL_FROM": "TinyCloud Share <invite@share.tinycloud.xyz>"
  },
  "d1_databases": [
    { "binding": "DELIVERIES", "database_name": "tinycloud-share-email", "database_id": "126707a5-c858-4938-bccc-72413aff6017" }
  ],
  "routes": [{ "pattern": "email.tinycloud.xyz/*", "zone_id": "29b3a489c28c19707f8a9dd91da9dc42" }]
}

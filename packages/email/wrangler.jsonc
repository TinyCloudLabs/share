// Independent email-only worker. See DEPLOYMENT.md — nothing deploys on merge.
{
  "name": "tinycloud-share-email",
  "account_id": "9959301f03d2db1a5fcf5e004278d467",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-22",
  "vars": {
    "SHARE_ORIGIN": "https://share.tinycloud.xyz",
    "REGISTRY_ORIGIN": "https://registry.tinycloud.xyz",
    "DELIVERY_AUDIENCE": "https://api.share.tinycloud.xyz",
    "EMAIL_FROM": "TinyCloud Share <invite@share.tinycloud.xyz>"
  },
  "d1_databases": [
    { "binding": "DELIVERIES", "database_name": "tinycloud-share-email", "database_id": "126707a5-c858-4938-bccc-72413aff6017" }
  ],
  "routes": [{ "pattern": "api.share.tinycloud.xyz/*", "zone_id": "29b3a489c28c19707f8a9dd91da9dc42" }]
}

# @tinycloud/share-email — Worker configuration
#
# Copy to `.env` and fill in. `.env` is gitignored; this file is committed and
# must never contain a real secret.
#
# In production these are NOT read from a file — they are Cloudflare Worker
# secrets and vars. This file exists for local `wrangler dev` and as the
# canonical list of what has to be provisioned. See DEPLOYMENT.md.
#
#   npx wrangler secret put RESEND_API_KEY
#   npx wrangler secret put NODE_INVITATION_KID
#   npx wrangler secret put NODE_INVITATION_PUBLIC_KEY
#   npx wrangler secret put DELIVERY_AUDIENCE
#
# Every one of these is required. The Worker refuses to send when any is unset
# — it answers `configuration-unavailable` (503) rather than falling back to a
# default. That is deliberate: a default here would mean sending mail on an
# unverified authorization.

# ─── secrets ────────────────────────────────────────────────────────────────

# Resend API key used to actually send the mail.
# The same value already exists as a repository secret on OpenCredentials.
# Do not copy it into a committed file.
RESEND_API_KEY=

# The key id the Node stamps into the delivery authorization it signs.
# Must match the Node's enrolled invitation kid exactly.
#   live value: did:web:tee.node.tinycloud.xyz#invitation-key-1
NODE_INVITATION_KID=

# The Node's invitation PUBLIC key — base64url, no padding, 43 chars / 32 bytes.
# The Worker verifies the Ed25519 signature on every delivery authorization
# against this. A wrong value means every send is refused as `untrusted`.
#
# WARNING: the value production publishes today is a DEVELOPMENT FIXTURE
# (tv7Sn8LztrteJyVgwP9aQL6b1kuiDq9CePhTx19HyrI — see Linear TC-359). Do not
# adopt it. The real key is derived inside the TEE and is readable from
#   GET https://tee.node.tinycloud.xyz/.well-known/tinycloud/node-keys
# once the node carrying that route is deployed (TC-369). Until then this
# cannot be filled in correctly, and the Worker will correctly refuse to send.
NODE_INVITATION_PUBLIC_KEY=

# The origin the Node stamps into `openCredentialsAudience`. Must equal the
# Node's configured `credentials_origin` exactly — a mismatch refuses, it never
# degrades. Change this in the same window as any Node-side change.
#   live value: https://witness.credentials.org
DELIVERY_AUDIENCE=

# ─── vars (already set in wrangler.jsonc; override only per-environment) ─────

# SHARE_ORIGIN=https://share.tinycloud.xyz
# NODE_ORIGIN=https://tee.node.tinycloud.xyz
# EMAIL_FROM=

{
  "name": "share",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:deploy": "vite build",
    "preview": "vite preview",
    "test": "vitest run --config vitest.viewer.config.ts",
    "test:e2e:artifact": "node test/e2e-html-artifact.mjs",
    "test:e2e:html-share": "node test/e2e-html-share.mjs",
    "test:e2e:mermaid": "node test/e2e-mermaid.mjs",
    "test:e2e:viewer-page": "node test/e2e-viewer-page.mjs",
    "test:e2e:viewer-page-usercontent": "VIEWER_PAGE_USERCONTENT=1 node test/e2e-viewer-page.mjs",
    "test:e2e:native-joined": "node test/e2e-prod/joined-gate.mjs",
    "test:e2e:artifact-gate": "node test/e2e-prod/artifact-viewer-gate.mjs",
    "test:e2e:html-folder-gate": "node test/e2e-prod/html-folder-gate.mjs",
    "test:e2e:production-origin-contract": "node --test test/e2e-prod/production-headers.test.mjs test/e2e-prod/recipient-output.test.mjs test/e2e-prod/recipient-trace.test.mjs test/e2e-prod/cli-transport.test.mjs test/e2e-prod/native-stack.test.mjs",
    "test:e2e:sender-signin": "node test/e2e-prod/sender-signin-smoke.mjs",
    "test:e2e:sender-layout": "node test/e2e-sender-layout.mjs",
    "test:e2e:apps-page": "node test/e2e-apps-page.mjs",
    "test:e2e:apps-widget-layer": "node test/e2e-apps-widget-layer.mjs",
    "typecheck": "tsc --noEmit",
    "notice:jsx": "tsx scripts/generate-jsx-notice.mts",
    "test:e2e:jsx": "node test/e2e-jsx.mjs",
    "build:usercontent": "tsx scripts/build-usercontent.mts",
    "test:e2e:jsx-usercontent": "tsx test/e2e-jsx-usercontent.mjs"
  },
  "dependencies": {
    "@openkey/sdk": "0.12.0",
    "@tailwindcss/browser": "4.3.3",
    "@tinycloud/bootstrap": "2.8.0",
    "@tinycloud/node-sdk": "3.3.0-beta.11",
    "@tinycloud/node-sdk-wasm": "1.7.7",
    "@tinycloud/sdk-core": "3.3.0-beta.11",
    "@tinycloud/sdk-services": "3.3.0-beta.11",
    "@tinycloud/share-envelope": "1.1.0",
    "@tinycloud/share-sdk": "1.2.0-beta.7",
    "@tinycloud/styles": "git+https://github.com/TinyCloudLabs/styles.git#767b808c01967eec77f9bd31f201defdb1be2bc4",
    "@tinycloud/web-sdk": "3.3.0-beta.12",
    "@tinycloud/web-sdk-wasm": "1.7.6",
    "d3": "7.9.0",
    "dompurify": "3.4.15",
    "lucide-react": "1.59.0",
    "mermaid": "11.17.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "siwe": "3.0.0",
    "sucrase": "3.35.1",
    "unified": "11.0.5",
    "viem": "^2.55.5"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.14.0",
    "esbuild": "0.25.12",
    "jsdom": "^26.1.0",
    "puppeteer": "24.31.0",
    "tsx": "4.23.0",
    "typescript": "^5.8.3",
    "vite": "^6.0.0",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "@tinycloud/sdk-core": "$@tinycloud/sdk-core",
    "@tinycloud/share-envelope": "$@tinycloud/share-envelope",
    "@tinycloud/share-sdk": "$@tinycloud/share-sdk"
  }
}

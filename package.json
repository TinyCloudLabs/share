{
  "name": "share",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:deploy": "SHARE_DEPLOY_BUILD=true vite build",
    "start:deploy": "SHARE_DEPLOY_STARTUP=true tsx src/host/production-server.ts",
    "check:deploy-config": "node scripts/validate-deploy-config.mjs",
    "check:phala-deploy-workflow": "node scripts/verify-phala-deploy-workflow.mjs",
    "preview": "vite preview",
    "test": "vitest run --config vitest.viewer.config.ts && vitest run packages",
    "test:e2e:email": "node test/e2e-email/integration.mjs",
    "link:web-sdk": "node scripts/link-web-sdk.mjs",
    "check:web-sdk-link": "node scripts/link-web-sdk.mjs --check",
    "test:e2e:sharing": "npm run check:web-sdk-link && SHARING_E2E_LOCAL_UNPUSHED=1 node test/e2e-sharing/integration.mjs",
    "test:e2e:artifact": "node test/e2e-html-artifact.mjs",
    "test:e2e:native-bearer": "node scripts/link-web-sdk.mjs --check --require-env && npm run build && tsx test/e2e-native-bearer/integration.mjs",
    "test:e2e:sharing:release": "npm run check:web-sdk-link && node test/e2e-sharing/integration.mjs",
    "test:e2e:tc-465": "node test/e2e-sharing/tc-465-joined.mjs",
    "test:e2e:tc-500": "node test/e2e-sharing/tc-465-joined.mjs --tc-500",
    "test:e2e:bearer:registry": "SHARING_E2E_REGISTRY_PACKAGES=1 SHARING_E2E_GENERIC_NODE=1 SHARING_E2E_REQUIRED_SLICES=bearer node test/e2e-sharing/integration.mjs",
    "test:e2e:email:fixture": "node test/e2e-email/integration.mjs --fixture-only",
    "test:e2e:share-payload-proof": "tsx test/e2e-email/share-payload-proof.ts",
    "dev:manual:share-link": "tsx test/e2e-email/manual-share-link.ts",
    "manual:email-preview": "tsx test/e2e-email/manual-email-preview.ts",
    "smoke:manual:share-link": "tsx test/e2e-email/manual-share-link.ts --smoke --test-manual-replace",
    "release:evidence": "node test/e2e-email/release-evidence.mjs",
    "typecheck": "tsc --noEmit",
    "sync:wireframes": "cp wireframes/*.svg public/wireframes/"
  },
  "dependencies": {
    "@openkey/sdk": "^0.9.0",
    "@tinycloud/bootstrap": "2.7.0",
    "@tinycloud/node-sdk": "3.0.0-beta.8",
    "@tinycloud/node-sdk-wasm": "1.7.6",
    "@tinycloud/operations": "0.3.3-beta.3",
    "@tinycloud/sdk-core": "3.0.0-beta.8",
    "@tinycloud/sdk-services": "2.11.0",
    "@tinycloud/web-sdk-wasm": "1.7.6",
    "@tinycloud/share-cli": "*",
    "@tinycloud/share-app-compat": "*",
    "@tinycloud/share-sdk": "0.3.0-beta.2",
    "@tinycloud/share-envelope": "0.2.1-beta.2",
    "@tinycloud/share-registry": "*",
    "@tinycloud/web-sdk": "3.0.0-beta.8",
    "dompurify": "3.4.12",
    "mermaid": "11.16.0",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "siwe": "3.0.0",
    "unified": "11.0.5",
    "viem": "^2.55.5"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "jsdom": "^26.1.0",
    "puppeteer": "24.31.0",
    "typescript": "^5.8.3",
    "vite": "^6.0.0",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "@tinycloud/sdk-core": "$@tinycloud/sdk-core",
    "@tinycloud/share-envelope": "$@tinycloud/share-envelope",
    "@tinycloud/share-sdk": "$@tinycloud/share-sdk"
  }
}

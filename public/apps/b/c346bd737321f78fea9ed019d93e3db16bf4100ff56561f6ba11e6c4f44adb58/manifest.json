{
  "manifest_version": 1,
  "app_id": "xyz.tinycloud.tinyapps.contacts",
  "name": "Contacts",
  "description": "Keep the people you know, and what you learn about them, in one place.",
  "appVersion": "0.1.0",
  "space": "applications",
  "defaults": false,
  "includePublicSpace": false,
  "expiry": "1h",
  "knowledge": "knowledge/index.md",
  "keys_app_id": "xyz.tinycloud.share",
  "keys": [
    {
      "path": "apps/xyz.tinycloud.share/xyz.tinycloud.tinyapps.contacts/seal-v1",
      "abilities": ["decrypt", "key.create"]
    }
  ],
  "permissions": [
    {
      "service": "tinycloud.kv",
      "path": "catalog",
      "actions": [
        "get",
        "put"
      ],
      "description": "Prepare the address book on first use."
    },
    {
      "service": "tinycloud.kv",
      "path": "catalog/person",
      "actions": [
        "get",
        "put"
      ],
      "description": "Prepare the person record description."
    },
    {
      "service": "tinycloud.kv",
      "path": "catalog/me",
      "actions": [
        "get",
        "put"
      ],
      "description": "Prepare the me record description."
    },
    {
      "service": "tinycloud.kv",
      "path": "catalog/note",
      "actions": [
        "get",
        "put"
      ],
      "description": "Prepare the note record description."
    },
    {
      "service": "tinycloud.kv",
      "path": "catalog/history",
      "actions": [
        "get",
        "put"
      ],
      "description": "Prepare the history record description."
    },
    {
      "service": "tinycloud.kv",
      "path": "person/",
      "actions": [
        "get",
        "list",
        "put"
      ],
      "description": "Find people and save their cards."
    },
    {
      "service": "tinycloud.kv",
      "path": "me/me",
      "actions": [
        "get",
        "put"
      ],
      "description": "Open and save your own card."
    },
    {
      "service": "tinycloud.kv",
      "path": "note/",
      "actions": [
        "get",
        "list",
        "put"
      ],
      "description": "Read entries and add recollections or corrections."
    },
    {
      "service": "tinycloud.kv",
      "path": "history/",
      "actions": [
        "get",
        "list",
        "put"
      ],
      "description": "Keep earlier cards and restore a version."
    }
  ]
}
